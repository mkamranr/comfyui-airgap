# =============================================================================
#  Copy to .env on EACH machine. The two machines want different values.
# =============================================================================

# --- Image identity (must match on both machines) ---------------------------
IMAGE_NAME=comfyui-airgap
IMAGE_TAG=v0.37.0

# --- Air-gapped host: runtime ------------------------------------------------
COMFY_PORT=8188

# MUST match the owner of ./models ./input ./output ./user on the TARGET host.
# Set with:  printf 'PUID=%s\nPGID=%s\n' "$(id -u)" "$(id -g)" >> .env
PUID=1000
PGID=1000

# Warn loudly in the log if the GPU is not visible inside the container.
# Set to 0 only if you deliberately want CPU inference.
COMFY_REQUIRE_GPU=1

# --- Internet machine: build-time only ---------------------------------------
# CUDA_IMAGE and TORCH_INDEX must agree with each other AND be supported by the
# NVIDIA driver on the air-gapped host. Verify with `nvidia-smi` on the TARGET.
#   cu128 -> driver >= 525    cu124 -> driver >= 525    cu121 -> driver >= 530
COMFYUI_REF=v0.37.0
CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
TORCH_INDEX=https://download.pytorch.org/whl/cu128

# Several GB of ControlNet annotator checkpoints. Keep at 1 unless you are
# certain you will never use a preprocessor node offline.
PREWARM_CONTROLNET_AUX=1

# ComfyUI-Frame-Interpolation checkpoints to bake in, as "<type>:<file>" pairs.
# Model types are the directory names under the node's vfi_models/ (rife, film,
# cain, amt, gmfss_fortuna, ifrnet, m2m, sepconv, stmfnet, flavr, ...).
# Anything not listed CANNOT be fetched later on the air-gapped host.
VFI_PREWARM=rife:rife47.pth rife:rife49.pth film:film_net_fp32.pt

# Nodes dropped into ./custom_nodes_local/ that fail to install:
# 1 = abort the build (default), 0 = report and continue.
LOCAL_NODES_STRICT=1
